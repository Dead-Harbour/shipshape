{
    "author": "ChrisOfNormandy",
    "description": "Common helper functions and configs.",
    "license": "MIT",
    "name": "@dead-harbour/shipshape",
    "packageManager": "yarn@4.19.0",
    "type": "module",
    "version": "1.0.8",
    "files": [
        "dist"
    ],
    "exports": {
        "./oxlint": {
            "types": "./dist/lib/oxlint.d.ts",
            "import": "./dist/lib/oxlint.js",
            "require": null
        },
        "./oxfmt": {
            "types": "./dist/lib/oxfmt.d.ts",
            "import": "./dist/lib/oxfmt.js",
            "require": null
        },
        "./numbers": {
            "types": "./dist/lib/numbers.d.ts",
            "import": "./dist/lib/numbers.js",
            "require": null
        },
        "./props": {
            "types": "./dist/lib/props.d.ts",
            "import": "./dist/lib/props.js",
            "require": null
        },
        "./sorting": {
            "types": "./dist/lib/sorting.d.ts",
            "import": "./dist/lib/sorting.js",
            "require": null
        },
        "./strings": {
            "types": "./dist/lib/strings.d.ts",
            "import": "./dist/lib/strings.js",
            "require": null
        },
        "./stylelint": {
            "types": "./dist/lib/stylelint.d.ts",
            "import": "./dist/lib/stylelint.js",
            "require": null
        }
    },
    "dependencies": {
        "@stylistic/stylelint-config": "^6.1.0",
        "@stylistic/stylelint-plugin": "^6.0.1",
        "stylelint": "^18.1.0",
        "stylelint-config-standard": "^41.1.0",
        "stylelint-config-standard-scss": "^18.0.0",
        "stylelint-scss": "^7.5.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.11",
        "knip": "^6.49.0",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.95.0",
        "oxlint-tsgolint": "^7.0.2009",
        "postcss": "^8.5.34",
        "tsc-alias": "^1.9.12",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "build": "yarn clean; tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "clean": "rm -rf dist",
        "lint": "oxlint . --fix; oxfmt; yarn lint:scss",
        "lint:scss": "yarn stylelint '**/*.scss' --fix",
        "sanity": "yarn typecheck && yarn lint && yarn knip",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    }
}
